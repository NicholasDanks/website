---
import SectionHeading from "../shared/SectionHeading.astro";
import Button from "../shared/Button.astro";
import PublicationCard from "../publications/PublicationCard.astro";

interface Publication {
  id: string;
  data: {
    title: string;
    authors: string[];
    journal: string;
    year: number;
    type: string;
    doi?: string;
    url?: string;
    citations?: number;
    featured?: boolean;
  };
}

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
---

<section class="py-16 sm:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Recent Publications"
      subtitle="Selected recent work in PLS-SEM methodology, predictive modeling, and model selection."
    />

    <div class="grid gap-4">
      {publications.map((pub) => (
        <PublicationCard
          title={pub.data.title}
          authors={pub.data.authors}
          journal={pub.data.journal}
          year={pub.data.year}
          type={pub.data.type}
          doi={pub.data.doi}
          url={pub.data.url}
          citations={pub.data.citations}
          featured={pub.data.featured}
        />
      ))}
    </div>

    <div class="mt-8 text-center">
      <Button href="/research" variant="secondary">
        View All Publications
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </Button>
    </div>
  </div>
</section>
