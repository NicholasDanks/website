---
interface Props {
  title: string;
  subtitle?: string;
  as?: "h1" | "h2";
}

const { title, subtitle, as: Heading = "h2" } = Astro.props;
---

<div class="mb-10">
  <Heading class="section-heading text-3xl sm:text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-50">
    {title}
  </Heading>
  {subtitle && (
    <p class="mt-4 text-lg text-surface-600 dark:text-surface-400 max-w-2xl">
      {subtitle}
    </p>
  )}
</div>
