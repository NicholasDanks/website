---
import PageLayout from "../layouts/PageLayout.astro";
import SectionHeading from "../components/shared/SectionHeading.astro";
import Button from "../components/shared/Button.astro";
import Timeline from "../components/cv/Timeline.astro";
import { timeline } from "../data/timeline";
import { site } from "../data/site";
import { getCollection } from "astro:content";

const pubCount = (await getCollection("publications")).length;
const seminr = (await getCollection("software")).find((s) => s.id.replace(/\.md$/, "") === "seminr");

---

<PageLayout
  title="CV — Nicholas P. Danks"
  description="Curriculum vitae of Nicholas P. Danks — academic positions, education, and achievements."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <SectionHeading as="h1"
        title="Curriculum Vitae"
        subtitle="Academic positions, education, and key milestones."
      />
      <Button href="/files/danks-cv.pdf" variant="primary" external>
        <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download PDF
      </Button>
    </div>

    <div class="max-w-2xl">
      <Timeline entries={timeline} />
    </div>

    <!-- Summary stats -->
    <div class="mt-16 grid grid-cols-2 sm:grid-cols-5 gap-6">
      <div class="text-center p-6 rounded-xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800">
        <div class="text-3xl font-bold text-accent-700 dark:text-accent-400">{pubCount}</div>
        <div class="text-sm text-surface-600 dark:text-surface-400 mt-1">Publications</div>
      </div>
      <div class="text-center p-6 rounded-xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800">
        <div class="text-3xl font-bold text-accent-700 dark:text-accent-400">{site.scholarMetrics.hIndex}</div>
        <div class="text-sm text-surface-600 dark:text-surface-400 mt-1">h-index</div>
      </div>
      <div class="text-center p-6 rounded-xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800">
        <div class="text-3xl font-bold text-accent-700 dark:text-accent-400">{site.scholarMetrics.i10Index}</div>
        <div class="text-sm text-surface-600 dark:text-surface-400 mt-1">i10-index</div>
      </div>
      <div class="text-center p-6 rounded-xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800">
        <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">2</div>
        <div class="text-sm text-surface-600 dark:text-surface-400 mt-1">R Packages</div>
      </div>
      <div class="text-center p-6 rounded-xl bg-white dark:bg-surface-900 border border-surface-200 dark:border-surface-800">
        <div class="text-3xl font-bold text-accent-600 dark:text-accent-400">{seminr?.data.downloads}</div>
        <div class="text-sm text-surface-600 dark:text-surface-400 mt-1">SEMinR downloads</div>
      </div>
    </div>
    <p class="mt-4 text-xs text-surface-500 dark:text-surface-400 text-center">
      Citation metrics from <a href={site.scholar} target="_blank" rel="noopener noreferrer" class="underline hover:text-accent-600 dark:hover:text-accent-400">Google Scholar</a>, {site.scholarMetrics.asOf}. Download count from CRAN logs (RStudio mirror, since 2018).
    </p>
  </div>
</PageLayout>
