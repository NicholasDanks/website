---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/home/Hero.astro";
import ResearchHighlights from "../components/home/ResearchHighlights.astro";
import FeaturedSoftware from "../components/home/FeaturedSoftware.astro";
import LatestPubs from "../components/home/LatestPubs.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";

const allPubs = await getCollection("publications");
const featured = allPubs
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5);

---

<PageLayout title={`${site.name} — ${site.title}`}>
  <Hero
    name={site.name}
    title={site.title}
    institution={site.institution}
    bio={site.bio}
    researchInterests={[...site.researchInterests]}
  />
  <ResearchHighlights />
  <FeaturedSoftware />
  <LatestPubs publications={featured} />
</PageLayout>
