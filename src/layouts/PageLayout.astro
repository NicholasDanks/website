---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const { title, description, ogImage, ogType } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType={ogType}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent-700 focus:text-white focus:shadow-lg"
  >
    Skip to content
  </a>
  <Header />
  <main id="main" tabindex="-1" class="pt-16">
    <slot />
  </main>
  <Footer />
</BaseLayout>
